generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  CLUB_ADMIN
  SUPER_ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
  club     Club?
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum ClubInterest {
  ACADEMIC_PROFESSIONAL
  STEM
  RECREATION
  ARTS_CULTURE
  COMMUNITY_SERVICE
}

model Club {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  website      String?
  contactEmail String?
  interest     ClubInterest?
  ownerId      Int?          @unique
  owner        User?         @relation(fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
